# Discord Developer Portal > General Information
DISCORD_CLIENT_ID=your_application_client_id
DISCORD_CLIENT_SECRET=your_oauth2_client_secret
DISCORD_BOT_TOKEN=your_bot_token

# Must exactly match the OAuth2 redirect URL configured in the Developer Portal.
# Example: https://your-domain.example/auth/discord/callback
BASE_URL=http://localhost:3000
OAUTH_CALLBACK_URL=http://localhost:3000/auth/discord/callback

# Use a long random value. Do not commit your real .env file.
SESSION_SECRET=replace_this_with_a_long_random_secret

# Optional: set this to register commands only in your test server during development.
# Leave blank to register commands globally.
DEV_GUILD_ID=

PORT=3000
DATABASE_PATH=./data/bot.sqlite
